{
    "compilerOptions": {
        "lib": ["ESNext"],
        "target": "esnext",
        "module": "commonjs",
        "rootDir": "./src",
        "outDir": "./build",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "typeRoots": ["./src/@types"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
